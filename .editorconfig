root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[tools/module-runner/**.{mjs,json}]
end_of_line = lf

[docs/development/*.md]
end_of_line = lf

[test/module-execution-framework.contract.spec.ts]
end_of_line = lf

[*.{ps1,cmd,bat}]
end_of_line = crlf
