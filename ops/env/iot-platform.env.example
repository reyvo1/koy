# Install as /etc/iot-platform/iot-platform.env with owner root:iot-platform and mode 0640.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
SWAGGER_ENABLED=false
LOG_LEVEL=info
DATABASE_URL=postgresql://iot_platform:REPLACE_WITH_SECRET@127.0.0.1:5432/iot_platform
REDIS_URL=redis://iot_platform:REPLACE_WITH_SECRET@127.0.0.1:6379
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_CLIENT_ID_PREFIX=iot-platform-api
# Dedicated broker publisher service account; do not reuse a device ID.
MQTT_USERNAME=REPLACE_WITH_PUBLISHER_USERNAME
MQTT_PASSWORD=REPLACE_WITH_PUBLISHER_PASSWORD
# MQTT_CA_FILE=/etc/iot-platform/mqtt-ca.pem
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_PUBLISH_TIMEOUT_MS=10000
MQTT_KEEPALIVE_SECONDS=30
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_WEBHOOK_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
METRICS_ACCESS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CORS_ALLOWED_ORIGINS=https://app.example.com
SENSITIVE_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
HEALTH_CHECK_TIMEOUT_MS=1000
COMMAND_ACK_TIMEOUT_MS=300000

# Business runtimes are fail-closed by default in application config.
# The reviewed production template explicitly enables them; production preflight rejects false/missing values.
SCHEDULER_RUNTIME_ENABLED=true
SCHEDULER_CLAIM_TIMEOUT_MS=300000
AUTOMATION_RUNTIME_ENABLED=true
NOTIFICATION_RUNTIME_ENABLED=true
NOTIFICATION_CLAIM_TIMEOUT_MS=60000

# Notification email delivery. Keep relay credentials in EMAIL_RELAY_TOKEN, never in the URL.
EMAIL_RELAY_URL=https://relay.example.com/v1/send
EMAIL_RELAY_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
EMAIL_FROM=no-reply@example.com
EMAIL_RELAY_TIMEOUT_MS=10000
