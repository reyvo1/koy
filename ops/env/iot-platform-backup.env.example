# Install as /etc/iot-platform/iot-platform-backup.env with owner root:postgres and mode 0640.
DATABASE_URL=postgresql://iot_backup:REPLACE_WITH_SECRET@127.0.0.1:5432/iot_platform
BACKUP_DIR=/var/backups/iot-platform
BACKUP_RETENTION_DAYS=35
BACKUP_GPG_RECIPIENT=backup@example.com
BACKUP_GNUPGHOME=/var/lib/postgresql/.gnupg
