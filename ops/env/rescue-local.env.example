# RESCUE-02B LOCAL INTEGRATION ONLY.
# Copy to .env, replace every REPLACE_WITH_* value, then keep .env uncommitted.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Optional explicit readiness URL for rescue preflight; defaults to http://127.0.0.1:${PORT}/health/ready.
API_PROBE_URL=http://127.0.0.1:3000/health/ready
SWAGGER_ENABLED=true
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# docker-compose.rescue.yml defaults
POSTGRES_USER=iot
POSTGRES_PASSWORD=iot_local_only
POSTGRES_DB=iot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iot:iot_local_only@127.0.0.1:5432/iot
# Integration runners create/drop only a run-owned test_* schema inside this local DB.
TEST_DATABASE_URL=postgresql://iot:iot_local_only@127.0.0.1:5432/iot
DATABASE_INTEGRATION_TESTS_ALLOWED=true

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
HEALTH_CHECK_TIMEOUT_MS=1000

MQTT_PORT=1883
# Dedicated host mapping for the rescue EMQX container. Keep this distinct from any local Mosquitto/dev broker.
RESCUE_MQTT_HOST_PORT=18884
RESCUE_MQTT_BROKER_URL=mqtt://127.0.0.1:18884
MQTT_WS_PORT=8083
MQTT_WSS_PORT=8084
MQTT_TLS_PORT=8883
EMQX_DASHBOARD_PORT=18083
MQTT_BROKER_URL=mqtt://127.0.0.1:18884
MQTT_CLIENT_ID_PREFIX=iot-platform-api
# Dedicated API publisher identity handled by POST /mqtt/auth.
MQTT_USERNAME=iot-platform-publisher
MQTT_PASSWORD=REPLACE_WITH_LOCAL_PUBLISHER_SECRET
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_PUBLISH_TIMEOUT_MS=10000
MQTT_KEEPALIVE_SECONDS=30
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_WEBHOOK_SECRET=REPLACE_WITH_LOCAL_WEBHOOK_SECRET
MQTT_INTEGRATION_TESTS_ALLOWED=true

JWT_SECRET=REPLACE_WITH_LOCAL_JWT_SECRET
METRICS_ACCESS_TOKEN=REPLACE_WITH_LOCAL_METRICS_TOKEN
COMMAND_ACK_TIMEOUT_MS=300000
SCHEDULER_RUNTIME_ENABLED=true
AUTOMATION_RUNTIME_ENABLED=true
SCHEDULER_CLAIM_TIMEOUT_MS=300000
SENSITIVE_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000

# Used only by scripts/configure-emqx-http-auth.mjs.
# Set these to the actual local EMQX Dashboard credentials before running it.
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_LOCAL_EMQX_DASHBOARD_PASSWORD
EMQX_API_URL=http://127.0.0.1:18083
IOT_API_FROM_EMQX=http://api:3000

# Wave 9 media runtime (go2rtc).
#
# go2rtc serves its control API on 1984 and its WebRTC endpoint on 8189. They are different ports for
# different purposes, and conflating them is a mistake worth naming: an earlier version of this file
# pointed GO2RTC_URL at 8189, and the readiness probe reported "unreachable" against a media runtime
# that was running and healthy one port over.
#
# `GO2RTC_URL` is the host-side control address, which is what the readiness probe and the media
# probe talk to. `GO2RTC_URL_INTERNAL` is the same address seen from inside the API container.
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_URL_INTERNAL=http://go2rtc:1984
GO2RTC_API_PORT=1984
GO2RTC_WEBRTC_PORT=8189
