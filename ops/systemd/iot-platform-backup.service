[Unit]
Description=Encrypted PostgreSQL backup for IoT Platform
After=postgresql.service

[Service]
Type=oneshot
TimeoutStartSec=30min
User=postgres
Group=postgres
EnvironmentFile=/etc/iot-platform/iot-platform-backup.env
ExecStart=/usr/local/lib/iot-platform/postgres-backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/iot-platform /var/lib/postgresql/.gnupg
