  "notStressed": [
    {
      "path": "/devices/:deviceId/telemetry/stream",
      "method": "SSE",
      "reason": "Long-lived server-sent events hold one connection for the scenario lifetime, so they would measure the load generator holding a socket open rather than platform throughput. Live probes cover the stream end-to-end."
    },
    {
      "path": "/camera-network/devices/:id/playback",
      "method": "POST",
      "reason": "Signalling requires a live go2rtc media server and a real SDP offer; CCTV remains QUARANTINE pending source-bound acceptance."
    },
    {
      "path": "/camera-network/devices/:id/playback/:sessionId",
      "method": "DELETE",
      "reason": "Same signalling prerequisite as the POST above."
    },
    {
      "path": "/camera-network/discover",
      "method": "GET",
      "reason": "ONVIF discovery is a broadcast against the operator network and cannot run meaningfully against the CI runtime."
    },
    {
      "path": "/ota/rollouts/:rolloutId",
      "method": "GET",
      "reason": "The platform exposes no rollout LIST route, so the only way to obtain an id is to create firmware artifacts and a rollout -- a write with real side effects. An operator reads rollout detail while watching one rollout, not under load."
    },
    {
      "path": "/ota/rollouts/:rolloutId/transition",
      "method": "POST",
      "reason": "Rollout state transitions mutate a live rollout against real devices; a stress run must not advance firmware campaigns."
    },
    {
      "path": "/ota/rollouts/:rolloutId/progress",
      "method": "POST",
      "reason": "Progress reporting is device-originated protocol traffic, not an operator surface."
    },
    {
      "path": "/ota/firmware-artifacts",
      "method": "POST",
      "reason": "Creating firmware artifacts uploads binaries that no stress run should leave behind."
    },
    {
