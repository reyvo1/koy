{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "app.config.ts",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.cjs",
    "src/**/*.d.cts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.spec.tsx"]
}
