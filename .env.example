NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SWAGGER_ENABLED=true
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
METRICS_ACCESS_TOKEN=change_me_in_production
SENSITIVE_RATE_LIMIT_MAX=10
SENSITIVE_RATE_LIMIT_WINDOW_MS=60000
DATABASE_URL=postgresql://user:password@localhost:5432/iot
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/iot_test
DATABASE_INTEGRATION_TESTS_ALLOWED=false
REDIS_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=1000
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_CLIENT_ID_PREFIX=iot-platform-api
# Dedicated broker publisher service account; do not reuse a device ID.
MQTT_USERNAME=REPLACE_WITH_PUBLISHER_USERNAME
MQTT_PASSWORD=REPLACE_WITH_PUBLISHER_PASSWORD
# MQTT_CA_FILE=/etc/iot-platform/mqtt-ca.pem
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_PUBLISH_TIMEOUT_MS=10000
MQTT_KEEPALIVE_SECONDS=30
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_WEBHOOK_SECRET=change_me_in_production
JWT_SECRET=change_me_in_production
COMMAND_ACK_TIMEOUT_MS=300000
SCHEDULER_RUNTIME_ENABLED=false
AUTOMATION_RUNTIME_ENABLED=false
SCHEDULER_CLAIM_TIMEOUT_MS=300000
MQTT_INTEGRATION_TESTS_ALLOWED=false
# Wave 2 notification delivery runtime. Keep disabled until an HTTPS relay is configured.
NOTIFICATION_RUNTIME_ENABLED=false
NOTIFICATION_CLAIM_TIMEOUT_MS=60000
EMAIL_RELAY_TIMEOUT_MS=10000
# EMAIL_RELAY_URL=https://mail-relay.example.com/v1/send
# EMAIL_RELAY_TOKEN=REPLACE_WITH_EMAIL_RELAY_TOKEN
# EMAIL_FROM=no-reply@example.com
