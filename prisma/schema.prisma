  syncStates    IntegrationSyncState[]
  createdAt     DateTime           @default(now())

  // `id` remains globally unique, while the composite identity lets child rows
  // prove that their tenantId belongs to the same integration at the database boundary.
  @@unique([id, tenantId])
  @@unique([tenantId, provider])
  @@index([tenantId, status])
  @@map("integrations")
}

model IntegrationSyncState {
  id               String     @id @default(uuid())
  tenantId         String
  integrationId    String
  integration      Integration @relation(fields: [integrationId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  entityType       String
  externalEntityId String
  internalEntityId String
  syncedAt         DateTime   @default(now())

  @@unique([integrationId, entityType, externalEntityId])
  @@map("integration_sync_state")
}

// ---------------------------------------------------------------------------
// Module 27 — Billing, Subscription, Usage & Quota
// ---------------------------------------------------------------------------

enum SubscriptionPlanTier {
  FREE
  STANDARD
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

/// Where an invoice is in its life. `PENDING` is only ever reached from a provider response --
/// there is no path that sets it locally without a payment actually existing.
enum InvoiceStatus {
  SIMULATED
  PENDING
  SETTLED
  FAILED
  EXPIRED
}

/// A single metered quantity for one device in one period.
///
/// Unique per (tenant, device, period) on purpose: a period that gets recounted must update the
/// existing row rather than append a second one, or a re-run silently bills the tenant twice.
model MeteringRecord {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  periodStart DateTime
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, deviceId, periodStart])
  @@index([tenantId, periodStart])
  @@map("metering_records")
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscriptionId  String?
  subscription    BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  /// The order id the platform asked the provider for. Unique per tenant, so a webhook can locate
  /// the invoice by the id the provider echoes back without scanning the table.
  providerOrderId String
  /// The provider's own id when it differs from the reference we supplied. Null on a simulated
  /// invoice, because no provider ever issued one.
  providerRef     String?
  /// Minor units as an integer. Never a float: money stored as a float is the defect that surfaces
  /// years later in a reconciliation nobody can explain.
  amountCents     Int
  currency        String        @default("IDR")
  status          InvoiceStatus @default(SIMULATED)
  paymentUrl      String?
  /// When the provider last told us something about this invoice, if anything.
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([id, tenantId])
  @@unique([tenantId, providerOrderId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("invoices")
}

model BillingPlan {
  id                      String             @id @default(uuid())
  tier                    SubscriptionPlanTier @unique
  deviceQuota             Int
  telemetryRetentionDays  Int
  monthlyPriceCents       Int
  subscriptions           BillingSubscription[]
  @@map("billing_plans")
}

model BillingSubscription {
  id                 String              @id @default(uuid())
  tenantId           String              @unique
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  planId             String
  plan               BillingPlan         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  status             SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime            @default(now())
  invoices           Invoice[]

  @@map("billing_subscriptions")
}

model BillingUsage {
  id                   String   @id @default(uuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  periodStart          DateTime
  deviceCount          Int      @default(0)
  telemetryPoints      BigInt   @default(0)

  @@map("billing_usage")
}

// ADR-004: additive device location (GPS) — one row per reported fix, kept as history.
//
// Changed in Wave 9. The original was `deviceId @unique` with no `tenantId`, which made it two things
// at once: unable to answer "where was this device when it went offline", because each fix
// overwrote the last; and answerable by anyone holding a device id, because the row belonged to
// nobody in particular. Both are fixed here — the row is tenant-owned, and it is append-only.
//
// `latitude`/`longitude` stay Float on purpose. Unlike money, a coordinate genuinely is fractional;
// do not "fix" this the way amountCents had to be fixed.
model DeviceLocation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deviceId String
  device   Device @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  latitude Float
  longitude Float
  /// Human-readable place name. Nullable because a GPS fix has no label of its own.
  label String?
  /// When the fix arrived, as opposed to when this row was written. Kept separate so a replayed or
  /// backfilled device timestamp is visible rather than silently becoming "now".
  recordedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, deviceId, recordedAt])
  @@index([tenantId, recordedAt])
  @@map("device_locations")
}

// ADR-005: additive device groups (grup perangkat) — logical grouping
model DeviceGroup {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     DeviceGroupMember[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("device_groups")
}

// ---------------------------------------------------------------------------
// Wave 6 — Saved reports
//
// `platform-reports/tenant-summary` and the tenant CSV export both recompute from `now`. That
// makes them honest about the present and useless for anything else: the number an operator read
// on Monday cannot be retrieved on Tuesday, so a report cannot be reproduced, and a report that
// cannot be reproduced cannot be used to reconcile two people who read it at different times.
//
// `SavedReport` stores the rendered payload together with the window that produced it. The
// payload is stored rather than the query, because regenerating on download would let the number
// move underneath the operator between saving and re-reading -- the exact failure this removes.
// ---------------------------------------------------------------------------

enum SavedReportKind {
  TENANT_SUMMARY
}

/// A report as it was produced, kept so it can be read again.
///
/// `expiresAt` is set at write time rather than computed on read, so the row states its own
/// expiry instead of the reader having to know the retention policy. Expired reports are hidden
/// from the list and refused on download; the row is not deleted, because a report that vanishes
/// silently is indistinguishable from one that was never run.
///
/// Deliberately no scheduling fields. The owner chose saved runs over scheduled ones, and a
/// `cron` column that nothing reads would be a feature that looks available in the data model
/// and is not available in the product.
model SavedReport {
  id                String           @id @default(uuid())
  tenantId          String
  kind              SavedReportKind
  /// The window that produced this report. Part of the artifact, not a parameter that was passed
  /// and forgotten -- without it the payload cannot be re-derived or checked against live data.
  rangeFrom         DateTime
  rangeTo           DateTime
  /// Hours the operator asked for, kept because `rangeFrom`/`rangeTo` alone do not say whether
  /// the report service clamped the request.
  requestedHours    Int
  /// Rendered output, stored as produced.
  payload           Json
  rowCount          Int              @default(0)
  /// The membership that saved it. The report list is the one place a report body could be read
  /// by someone other than the operator who generated it.
  actorMembershipId String
  createdAt         DateTime         @default(now())
  expiresAt         DateTime

  @@index([tenantId, createdAt])
  @@index([expiresAt])
  @@map("saved_reports")
}

model DeviceGroupMember {
  groupId  String
  group    DeviceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  deviceId String
  device   Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([groupId, deviceId])
  @@index([deviceId])
  @@map("device_group_members")
}

/// Durable technician recurrence; every due occurrence and its window commit together.
model MaintenancePlan {
  id String @id @default(uuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceId String
  device Device @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  actorMembershipId String?
  actorMembership Membership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  reason String
  intervalHours Int
  nextDueAt DateTime
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  windows DeviceMaintenance[]
  @@unique([id, tenantId])
  @@index([enabled, nextDueAt])
  @@map("maintenance_plans")
}
