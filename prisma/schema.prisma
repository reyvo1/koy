generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  maintenancePlans MaintenancePlan[]
  id          String          @id @default(uuid())
  name        String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  users       User[]
  devices     Device[]
  deviceGroups DeviceGroup[]
  telemetry   Telemetry[]
  telemetryRollups TelemetryRollup[]
  regions                  Region[]
  edgeGateways            EdgeGateway[]
  twinSnapshots            DeviceTwinSnapshot[]
  commands    DeviceCommand[]
  memberships Membership[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  scenes               Scene[]
  sceneExecutions      SceneExecution[]
  schedules            Schedule[]
  scheduleRuns         ScheduleRun[]
  notificationTemplates NotificationTemplate[]
  notifications         Notification[]
  firmwareArtifacts     FirmwareArtifact[]
  otaRollouts           OtaRollout[]
  analyticsFindings     AnalyticsFinding[]
  nocAcknowledgements   NocAcknowledgement[]
  spaces                Space[]
  shareGrants           DeviceShareGrant[]
  organizationBranches  OrganizationBranch[] @relation("BranchTenant")
  customRoles           CustomRole[]
  apiKeys               ApiKey[]
  webhookEndpoints      WebhookEndpoint[]
  webhookDeliveries     WebhookDelivery[]
  integrations          Integration[]
  billingSubscription   BillingSubscription?
  billingUsage          BillingUsage?

  invoices                Invoice[]
  meteringRecords         MeteringRecord[]
  @@map("tenants")
  deviceLocations       DeviceLocation[]
}

model User {
  id                      String          @id @default(uuid())
  email                   String
  name                    String? // Added name field
  tenantId                String
  tenant                  Tenant          @relation(fields: [tenantId], references: [id])
  credential              UserCredential?
  isVerified              Boolean         @default(false)
  verificationTokenHash   String?         @unique
  verificationTokenLookup String?         @unique
  resetTokenHash          String?         @unique
  resetTokenLookup        String?         @unique
  resetTokenExpires       DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  memberships             Membership[]
  ownedDevices            Device[]
  openedMaintenance       DeviceMaintenance[] @relation("MaintenanceOpenedBy")
  resolvedMaintenance     DeviceMaintenance[] @relation("MaintenanceResolvedBy")

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model Membership {
  maintenancePlans MaintenancePlan[]
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  role            String      @default("MEMBER") // MEMBER, ADMIN, PLATFORM_ADMIN
  status          String      @default("ACTIVE") // ACTIVE, PENDING, REVOKED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  ownedDashboards  Dashboard[]  @relation("DashboardOwnerMembership")
  ownedAutomations Automation[] @relation("AutomationOwnerMembership")
  notificationPreferences NotificationPreference[]
  shareGrantsReceived     DeviceShareGrant[]      @relation("ShareGrantee")
  ownedOrganizations      Organization[]          @relation("OrganizationOwner")
  roleOverrides           MembershipRoleOverride[]

  @@unique([userId, tenantId])
  @@unique([id, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("memberships")
}

model UserCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("user_credentials")
}

model RefreshTokenFamily {
  id        String         @id @default(uuid())
  userId    String
  tenantId  String
  isRevoked Boolean        @default(false)
  createdAt DateTime       @default(now())
  tokens    RefreshToken[]

  @@index([userId])
  @@map("refresh_token_families")
}

model RefreshToken {
  id          String             @id @default(uuid())
  tokenHash   String             @unique
  tokenLookup String             @unique
  familyId    String
  family      RefreshTokenFamily @relation(fields: [familyId], references: [id])
  userId      String
  tenantId    String
  expiresAt   DateTime
  isRevoked   Boolean            @default(false)
  createdAt   DateTime           @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([tokenHash])
  @@index([tokenLookup])
  @@map("refresh_tokens")
}

/// One open maintenance window per device, addressed by tenant.
///
/// The migration also installs a partial unique index for OPEN windows.
/// Service preflight and P2002 mapping keep concurrent attempts actionable.
model DeviceMaintenance {
  id              String           @id @default(uuid())
  tenantId        String
  deviceId        String
  device          Device           @relation(fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Cascade)
  status          MaintenanceStatus @default(OPEN)
  planId          String?
  scheduledFor    DateTime?
  plan            MaintenancePlan? @relation(fields: [planId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: NoAction)
  reason          String
  openedByUserId  String
  openedBy        User             @relation("MaintenanceOpenedBy", fields: [openedByUserId], references: [id])
  openedAt        DateTime         @default(now())
  resolvedByUserId String?
  resolvedBy      User?            @relation("MaintenanceResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt      DateTime?
  resolutionNote  String?

  @@unique([planId, scheduledFor])
  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([deviceId, status])
  @@map("device_maintenance")
}

model Device {
  maintenancePlans MaintenancePlan[]
  id                       String                   @id @default(uuid())
  name                     String
  type                     DeviceType               @default(SENSOR)
  status                   DeviceStatus             @default(PROVISIONING)
  tenantId                 String
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id])
  ownerId                  String?
  owner                    User?                    @relation(fields: [ownerId], references: [id])
  provisioningTokenHash    String?
  provisioningTokenExpires DateTime?
  reportedFirmwareVersion String?
  reportedProtocol String?
  runtimeReportedAt DateTime?
  lastHeartbeatAt          DateTime?
  healthScore              Int?
  healthStatus             DeviceHealth?
  healthEvaluatedAt        DateTime?
  healthScorerVersion     String?
  riskBand                DeviceRisk?
  riskHorizonDays         Int?
  riskEvaluatedAt         DateTime?
  riskForecastVersion     String?
  credential               DeviceCredential?
  telemetry                Telemetry[]
  telemetryRollups         TelemetryRollup[]
  commands                 DeviceCommand[]
  capabilities             Capability[]
  dashboardBindings        DashboardWidgetBinding[] @relation("DashboardBindingDevice")
  deviceGroupMembers       DeviceGroupMember[]
  meteringRecords          MeteringRecord[]
  automationTriggers       Automation[]              @relation("AutomationTriggerDevice")
  automationActions          AutomationAction[]          @relation("AutomationActionDevice")
  automationExecutionTriggers AutomationExecution[]       @relation("AutomationExecutionTriggerDevice")
  automationExecutionActions  AutomationExecutionAction[] @relation("AutomationExecutionActionDevice")
  sceneActions              SceneAction[]              @relation("SceneActionDevice")
  spacePlacement            SpaceDevicePlacement?
  shareGrants               DeviceShareGrant[]
  maintenanceWindows        DeviceMaintenance[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([ownerId])
  @@map("devices")
  deviceLocations          DeviceLocation[]
  edgeGateways             EdgeGatewayDevice[]
  twinSnapshots            DeviceTwinSnapshot[]
  region                   Region?                 @relation(fields: [regionId], references: [id])
  regionId                 String?
}

model DeviceCredential {
  id           String   @id @default(uuid())
  deviceId     String   @unique
  device       Device   @relation(fields: [deviceId], references: [id])
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("device_credentials")
}

model DeviceCommand {
  id             String        @id @default(uuid())
  correlationId  String        @unique @default(uuid())
  idempotencyKey String?
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id])
  payload        Json
  status         CommandStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  sentAt         DateTime?
  acknowledgedAt DateTime?
  updatedAt      DateTime      @updatedAt
  automationExecutionActions AutomationExecutionAction[] @relation("AutomationExecutionActionCommand")

  @@unique([id, tenantId])
  @@unique([deviceId, idempotencyKey])
  @@index([tenantId])
  @@index([deviceId])
  @@index([status])
  @@index([status, sentAt])
  @@map("device_commands")
}

// ---------------------------------------------------------------------------
// Wave 6 — Capability template lifecycle
//
// `Capability.schemaVersion` exists per device, and `@@unique([deviceId, key])` means every
// device declares its own version. That is what makes drift possible: the same key can sit at
// 1.0.0 on one device and 2.0.0 on another, with nothing recording which is correct. The drift
// report has existed and been rendered; this is what gives it an answer.
// ---------------------------------------------------------------------------

enum CapabilityTemplateStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

/// The tenant-wide declaration of a capability key — what shape it should have, independent of
/// any single device. `key` is unique per tenant, so a fleet converges on one description
/// rather than each device inventing one.
model CapabilityTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  key         String
  semanticType String
  dataType    String
  unit        String?
  description String?
  /// Set when the key was deprecated from the template side. Distinct from the version's own
  /// lifecycle status: a key can be alive while its latest version is deprecated.
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions    CapabilityTemplateVersion[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("capability_templates")
}

/// One published revision of a template's shape.
///
/// `status` is a column rather than something derived from `createdAt`, because "which version
/// is the fleet standardising on" has to be answerable, and an old draft must not read as
/// current merely by being old.
///
/// The `CREATE UNIQUE INDEX … WHERE status = 'PUBLISHED'` in the migration is what makes
/// "publish" exclusive: without it two published versions can coexist and the fleet target
/// becomes undefined. It is deliberately *not* `@@unique([templateId, status])` — that would
/// also cap the template at one draft and one deprecated version, so the second deprecation of
/// a template's life would fail on a constraint with no visible cause.
///
/// Deprecating a version flips its status and inserts the replacement in one transaction, so
/// no caller can observe a template with two published versions.
model CapabilityTemplateVersion {
  id             String                   @id @default(uuid())
  templateId     String
  template       CapabilityTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version        String
  status         CapabilityTemplateStatus @default(DRAFT)
  constraints    Json?
  isReadable     Boolean                  @default(true)
  isWritable     Boolean                  @default(false)
  isReportable   Boolean                  @default(true)
  publishedAt    DateTime?
  deprecatedAt   DateTime?
  /// The semantic type this revision changed, when a publication altered it. Nullable: most
  /// revisions do not change it.
  previousSemanticType String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([templateId, version])
  @@index([status])
  @@map("capability_template_versions")
}

model Capability {
  id                String                   @id @default(uuid())
  deviceId          String
  device            Device                   @relation(fields: [deviceId], references: [id])
  key               String
  semanticType      String
  dataType          String
  unit              String?
  constraints       Json? // min, max, enum, precision
  isReadable        Boolean                  @default(true)
  isWritable        Boolean                  @default(false)
  isReportable      Boolean                  @default(true)
  schemaVersion     String                   @default("1.0.0")
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  dashboardBindings DashboardWidgetBinding[] @relation("DashboardBindingCapability")
  automationTriggers Automation[]              @relation("AutomationTriggerCapability")
  automationActions           AutomationAction[]          @relation("AutomationActionCapability")
  automationExecutionTriggers AutomationExecution[]       @relation("AutomationExecutionTriggerCapability")
  automationExecutionActions  AutomationExecutionAction[] @relation("AutomationExecutionActionCapability")
  sceneActions      SceneAction[]            @relation("SceneActionCapability")

  @@unique([deviceId, key])
  @@unique([id, deviceId])
  @@index([deviceId])
  @@map("capabilities")
}

model Telemetry {
  id        String   @id @default(uuid())
  eventId   String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  payload   Json
  createdAt            DateTime              @default(now())
  automationExecutions AutomationExecution[] @relation("AutomationExecutionTriggerTelemetry")

  /// Which gateway delivered this reading, when a gateway did. Null means the device reported for itself,
  /// which is true for every row written before ADR-010 -- so this is deliberately nullable with no
  /// default. Populating it retroactively would be inventing a delivery path nobody observed.
  deliveredByGatewayId String?
  deliveredByGateway   EdgeGateway?  @relation(fields: [deliveredByGatewayId], references: [id])

  @@unique([id, tenantId])
  @@unique([deviceId, eventId])
  @@index([tenantId])
  /// Retention and rollup both range over `createdAt` for a single tenant without naming a device.
  /// The composite `[tenantId, deviceId, createdAt, id]` index cannot serve that: after the tenant
  /// equality it needs `deviceId`, so a tenant-wide `createdAt` range falls back to a scan. Measured
  /// on the 1M-row local scale probe: the pre-index rollup read of a 30-day window and the batched
  /// prune both keyed off this shape, and the scale test compares before/after.
  @@index([tenantId, createdAt])
  @@index([deviceId])
  @@index([createdAt])
  @@index([tenantId, deviceId, createdAt, id])
  @@index([deliveredByGatewayId])
  @@map("telemetry")
}

/// Wave 10 — the summarised form of `telemetry` for windows whose raw rows are about to be removed.
///
/// The raw table is the highest-volume table in the system. Once its rows past a retention window are
/// pruned the history is gone unless something durable carries it, so the aggregate is written first and
/// the raw rows are deleted second.
///
/// The identity is (tenant, device, capability, bucketStart). `capabilityKey` is a top-level payload key
/// and not a device capability id, because telemetry payloads are free-form JSON (`{ "temp": 25 }`) and a
/// rollup that assumed the capability catalog would silently skip every payload that does not match it.
///
/// The distribution is kept rather than just a mean: a single spike inside a window is invisible in an
/// average and is exactly what an operator reviewing a chart needs to see.
model TelemetryRollup {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  deviceId      String
  device        Device   @relation(fields: [deviceId], references: [id])
  capabilityKey String
  bucketStart   DateTime
  bucketEnd     DateTime
  sampleCount   Int
  valueSum      Float
  valueMin      Float
  valueMax      Float
  valueLast     Float

  createdAt DateTime @default(now())

  @@unique([tenantId, deviceId, capabilityKey, bucketStart])
  @@index([tenantId, deviceId, bucketStart])
  @@index([tenantId, bucketStart])
  @@map("telemetry_rollups")
}

model Dashboard {
  id                String            @id @default(uuid())
  tenantId          String
  ownerMembershipId String
  ownerMembership   Membership        @relation("DashboardOwnerMembership", fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  name              String
  description       String?
  audience          DashboardAudience @default(PERSONAL)
  schemaVersion     String            @default("1.0.0")
  revision          Int               @default(1)
  layouts           DashboardLayout[]
  widgets           DashboardWidget[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, ownerMembershipId])
  @@index([tenantId, audience])
  @@map("dashboards")
}

model DashboardLayout {
  id          String                @id @default(uuid())
  tenantId    String
  dashboardId String
  dashboard   Dashboard             @relation(fields: [dashboardId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  breakpoint  DashboardBreakpoint
  columns     Int
  rowHeight   Int
  gap         Int
  items       DashboardLayoutItem[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([id, tenantId])
  @@unique([dashboardId, breakpoint])
  @@index([tenantId, dashboardId])
  @@map("dashboard_layouts")
}

model DashboardWidget {
  id                 String                   @id @default(uuid())
  tenantId           String
  dashboardId        String
  dashboard          Dashboard                @relation(fields: [dashboardId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  kind               DashboardWidgetKind
  title              String
  schemaVersion      String                   @default("1.0.0")
  presentationConfig Json?
  layoutItems        DashboardLayoutItem[]
  bindings           DashboardWidgetBinding[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([id, tenantId])
  @@index([tenantId, dashboardId])
  @@map("dashboard_widgets")
}

model DashboardLayoutItem {
  id        String          @id @default(uuid())
  tenantId  String
  layoutId  String
  layout    DashboardLayout @relation(fields: [layoutId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  widgetId  String
  widget    DashboardWidget @relation(fields: [widgetId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  x         Int
  y         Int
  width     Int
  height    Int
  minWidth  Int?
  minHeight Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([layoutId, widgetId])
  @@index([tenantId, layoutId])
  @@index([tenantId, widgetId])
  @@map("dashboard_layout_items")
}

model DashboardWidgetBinding {
  id           String                 @id @default(uuid())
  tenantId     String
  widgetId     String
  widget       DashboardWidget        @relation(fields: [widgetId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Cascade)
  alias        String
  intent       DashboardBindingIntent
  mode         DashboardBindingMode
  deviceId     String
  device       Device                 @relation("DashboardBindingDevice", fields: [deviceId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  capabilityId String?
  capability   Capability?            @relation("DashboardBindingCapability", fields: [capabilityId, deviceId], references: [id, deviceId], onDelete: Restrict, onUpdate: Cascade)
  queryConfig  Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([widgetId, alias])
  @@index([tenantId, widgetId])
  @@index([tenantId, deviceId])
  @@index([capabilityId, deviceId])
  @@map("dashboard_widget_bindings")
}

enum DashboardAudience {
  PERSONAL
  TENANT_SHARED
}

enum DashboardBreakpoint {
  DESKTOP
  TABLET
  MOBILE
}

enum DashboardWidgetKind {
  CARD
  SWITCH
  GAUGE
  CHART
  MAP
  TABLE
  STATUS
}

enum DashboardBindingIntent {
  READ
  REPORT
  WRITE
}

enum DashboardBindingMode {
  DEVICE_STATUS
  LATEST
  HISTORY
  AGGREGATE
  COMMAND
}

enum DeviceType {
  SENSOR
  ACTUATOR
  GATEWAY
  CAMERA
}

/// A maintenance window is a separate record rather than a `DeviceStatus` value because
/// `DeviceService.updateHeartbeat` writes `status: ACTIVE` on every heartbeat. A maintenance member
/// of `DeviceStatus` would be overwritten by the device's own next ping, so a window would close
/// itself within seconds of opening. Maintenance is therefore state that outlives the heartbeat,
/// and the device's liveness state stays exactly what it was.
enum MaintenanceStatus {
  OPEN
  RESOLVED
}

enum DeviceStatus {
  PROVISIONING
  PAIRED
  ACTIVE
  INACTIVE
  REVOKED
}

/// How well a device is doing, independent of whether it is switched on. A device can be ACTIVE and
/// still be reporting values far outside its own history, which a status cannot express.
/// What the reconciliation concluded. UNKNOWN and STALE are first-class outcomes, not failures:
/// UNKNOWN means the device has never reported, STALE means its last observation is past the horizon.
/// Neither may be collapsed into "looks fine".
enum DeviceTwinVerdict {
  ALIGNED
  DIVERGENT
  STALE
  UNKNOWN
}

/// UNKNOWN is the default and the honest starting state: a gateway that has never reported has no
/// evidence of being up, and defaulting it to ONLINE would be a claim the platform cannot support.
enum EdgeGatewayStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  DISABLED
}

enum DeviceHealth {
  HEALTHY
  DEGRADED
  UNHEALTHY
  OFFLINE
}

/// A gateway that delivers telemetry on behalf of a bounded set of a tenant's devices.
///
/// A gateway is an identity, not a label: it holds its own credential, so a gateway can be authenticated
/// and revoked without touching any device's own credential. `lastSeenAt` is null until a gateway has
/// actually reported, because a gateway that has never been seen must not read as online (ADR-010).
model EdgeGateway {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  gatewayCode  String
  displayName  String
  gatewayStatus EdgeGatewayStatus @default(UNKNOWN)
  regionId     String?
  region       Region?  @relation(fields: [regionId], references: [id])
  lastSeenAt   DateTime?
  credential   EdgeGatewayCredential?
  devices      EdgeGatewayDevice[]
  deliveredTelemetry Telemetry[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, gatewayCode])
  @@index([tenantId, gatewayStatus])
  @@map("edge_gateways")
}

/// A gateway's own credential. Separate from DeviceCredential because that is unique per device, and a
/// gateway is not a device -- one gateway serves many.
model EdgeGatewayCredential {
  id           String     @id @default(uuid())
  gatewayId    String     @unique
  gateway      EdgeGateway @relation(fields: [gatewayId], references: [id])
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("edge_gateway_credentials")
}

/// The explicit set of devices a gateway may speak for. A list, not a region: "everything in this region"
/// would silently widen whenever a device is commissioned, and an allowlist that grows on its own is not an
/// allowlist.
model EdgeGatewayDevice {
  id         String      @id @default(uuid())
  gatewayId  String
  gateway    EdgeGateway @relation(fields: [gatewayId], references: [id])
  deviceId   String
  device     Device      @relation(fields: [deviceId], references: [id])
  createdAt  DateTime    @default(now())

  @@unique([gatewayId, deviceId])
  @@index([deviceId])
  @@map("edge_gateway_devices")
}

/// A dated reconciliation of what the platform believes about a device against what the device last reported.
///
/// `observedAt` is when the DEVICE reported, not when this row was written -- without it a fresh reading and
/// a week-old one are indistinguishable. `observedStatus` and `observedPayload` are nullable because a device
/// that has never reported leaves them null and the verdict is UNKNOWN; there is no default reading to fall
/// back on. `twinVersion` is monotonic per device and unique, so a retried write updates rather than forks.
model DeviceTwinSnapshot {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  deviceId         String
  device           Device            @relation(fields: [deviceId], references: [id])
  twinVersion      Int
  desiredStatus    String?
  observedStatus   String?
  observedPayload  Json?
  observedAt       DateTime?
  verdict          DeviceTwinVerdict
  divergenceReason String?
  createdAt        DateTime          @default(now())

  @@unique([deviceId, twinVersion])
  @@index([tenantId, deviceId, createdAt])
  @@index([tenantId, verdict])
  @@map("device_twin_snapshots")
}

/// A deployment region a tenant's devices actually live in. `regionCode` is the platform's stable handle
/// for it; `isActive` is what makes the list authoritative, so a decommissioned region stops being
/// assignable rather than lingering as an option in a picker.
model Region {
  id           String   @id @default(uuid())
  regionCode   String   @unique
  displayName  String
  timezone     String
  isActive     Boolean  @default(true)
  tenants      Tenant[]
  devices      Device[]
  edgeGateways     EdgeGateway[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The rest of the schema names its tables in lower case; without this Prisma would map the model to a
  // table literally called `Region` and every query would fail against the migrated `regions` table.
  @@map("regions")
}

/// How much attention a device needs soon. NOT_ESTABLISHED is the honest default: too few observations to
/// tell "holding steady" from "we have not been watching closely enough".
enum DeviceRisk {
  NOT_ESTABLISHED
  STABLE
  WATCH
  DECLINING
  IMMINENT
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  FAILED
  TIMED_OUT
}


model Automation {
  id                  String                @id @default(uuid())
  tenantId            String
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ownerMembershipId   String
  ownerMembership     Membership            @relation("AutomationOwnerMembership", fields: [ownerMembershipId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Cascade)
  name                String
  schemaVersion       String                @default("1.0.0")
