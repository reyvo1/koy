// ---------------------------------------------------------------------------
// Wave 6 — NOC operations
//
// The NOC console renders `AnalyticsFinding` rows and had no verb for acting on one. The census
// found 23 hits for "ack" that were all command acknowledgements, one `on-call` in auth.service,
// and nothing at all for runbook, postmortem, escalation or bulk action -- so a console that
// could see a CRITICAL finding had no way to record that a human had seen it.
//
// `NocAcknowledgement` is that record. It is a separate table rather than two columns on
// `AnalyticsFinding` because the finding is detector-owned and append-only, and an operator's
// action on it is a different fact with a different writer.
// ---------------------------------------------------------------------------

/// A human having seen a finding.
///
/// Separate from resolving it. Acknowledging means "I have looked"; resolving means "this is
/// fixed". Collapsing the two lets a first responder close an incident by acknowledging it, and
/// the next responder has no way to know -- so the fields are separate and resolving requires an
/// acknowledgement to exist first.
///
/// Unique on `findingId`, which is what stops a second acknowledgement overwriting the actor and
/// timestamp of the first. Re-acknowledging returns the existing row rather than rewriting it: the
/// value of the record is "who was on duty when this was first seen".
model NocAcknowledgement {
  id                String   @id @default(uuid())
  findingId         String
  finding           AnalyticsFinding @relation(fields: [findingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// From the authenticated session, never a request body: an acknowledgement is a claim about
  /// who was on duty, and a body-supplied actor would let one operator record another's name.
  actorMembershipId  String
  acknowledgedAt    DateTime @default(now())
  /// Optional operator note. Kept separate from the acknowledgement itself so a later note cannot
  /// rewrite when the finding was first seen.
  note              String?
  /// Set when the incident is actually closed, and only ever after `acknowledgedAt` exists.
  resolvedAt        DateTime?
  resolvedBy        String?

  @@unique([findingId])
  @@index([tenantId, acknowledgedAt])
  @@map("noc_acknowledgements")
}

model AnalyticsFinding {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deviceId            String
  capabilityKey       String
  kind                AnalyticsFindingKind
  severity            AnalyticsSeverity
  summary             String
  confidence          Float
  detectorVersion     String
  evidenceTelemetryId String?
  createdAt           DateTime             @default(now())
  /// The operator action, if any. Nullable because the finding exists before anyone looks, and the
  /// detector writes this row without knowing whether a NOC is staffed tonight.
  acknowledgement     NocAcknowledgement?

  @@index([tenantId, createdAt])
  @@index([tenantId, deviceId])
  @@map("analytics_findings")
}

