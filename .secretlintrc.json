{
  "rules": [
    {
      "id": "@secretlint/preset-recommend",
      "rules": [
        {
          "id": "@secretlint/secretlint-rule-database-connection-string",
          "allowMessage": "^//\\s*secretlint-allow:.*$|:(admin|password|secret|test|user|postgres|iot|changeme|local|dev)[^:@]*@"
        }
      ]
    }
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/build/**",
    "**/package-lock.json",
    "**/test/fixtures/**",
    "**/__fixtures__/**",
    "**/*.md"
  ]
}