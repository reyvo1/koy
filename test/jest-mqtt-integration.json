{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.mqtt-integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/setup-mqtt-integration.ts"],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/"],
  "maxWorkers": 1,
  "testTimeout": 30000,
  "detectOpenHandles": true,
  "openHandlesTimeout": 3000
}
